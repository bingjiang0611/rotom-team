{
    "name": "rotom-team",
    "version": "0.1.0",
    "description": "Self-hosted shared agent sessions with personal ChatGPT and Qoder accounts",
    "private": true,
    "type": "module",
    "license": "UNLICENSED",
    "author": "Tanner Middleton",
    "bin": {
        "rotom-team": "bin/rotom-team.js"
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "postinstall": "node scripts/prepare-runtime.mjs",
        "prepare:runtime": "node scripts/prepare-runtime.mjs",
        "install:kernel": "npm ci --prefix runtime/rotom --ignore-scripts && node scripts/check-kernel.ts",
        "test:kernel": "node test/rotom-kernel-proof.ts",
        "test:kernel:proxy": "node test/rotom-kernel-proof.ts --proxy",
        "test:kernel:app": "node test/team-kernel-proof.ts",
        "test:kernel:ui": "node test/team-kernel-proof.ts --ui",
        "test:kernel:history": "node test/rotom-history-proof.ts",
        "test:kernel:qoder": "node --test test/rotom-qoder-unit.ts && node test/rotom-qoder-proof.ts && node test/rotom-qoder-proof.ts qmodel",
        "pretest": "node scripts/prepare-runtime.mjs",
        "pretest:team": "node scripts/prepare-runtime.mjs",
        "start": "node bin/rotom-team.js",
        "dev": "node bin/rotom-team.js --cwd .",
        "demo": "node test/team-serve.ts",
        "demo:kernel": "node test/team-kernel-demo.ts",
        "test:team": "node --test test/team.test.ts",
        "check": "tsc --noEmit -p .",
        "test": "node --test --test-concurrency=2 test/*.test.ts",
        "format": "eslint --fix . && prettier --write .",
        "format:check": "prettier --check . && eslint .",
        "lint": "eslint ."
    },
    "dependencies": {
        "@earendil-works/chord": "1.0.2",
        "@earendil-works/pi-ai": "1.0.2",
        "@earendil-works/pi-codemode": "1.0.2",
        "@earendil-works/pi-coding-agent": "1.0.2",
        "@earendil-works/pi-durable": "1.0.2",
        "dompurify": "^3.4.16",
        "htm": "^3.1.1",
        "jiti": "2.7.0",
        "marked": "^18.0.14",
        "preact": "^11.0.0",
        "qrcode": "^1.5.4",
        "undici": "8.10.2"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "^26.6.4",
        "@types/qrcode": "^1.5.6",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.9.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.1"
    }
}
